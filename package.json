{
    "name": "@calltek/invo-sdk",
    "version": "1.0.0",
    "type": "module",
    "description": "TypeScript SDK for the ORUGA VERI*FACTU API (formerly INVO)",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "prepare": "npm run build",
        "build": "rollup -c",
        "build:watch": "rollup -c --watch",
        "clean": "rm -rf dist",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run clean && npm run build && npm test"
    },
    "keywords": [
        "verifactu",
        "veri*factu",
        "aeat",
        "factura",
        "invoice",
        "oruga",
        "invo",
        "sdk",
        "typescript",
        "calltek"
    ],
    "author": "Calltek",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/calltek/invo-sdk-ts.git"
    },
    "bugs": {
        "url": "https://github.com/calltek/invo-sdk-ts/issues"
    },
    "homepage": "https://github.com/calltek/invo-sdk-ts#readme",
    "devDependencies": {
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/node": "^24.10.1",
        "@typescript-eslint/eslint-plugin": "^8.46.4",
        "@typescript-eslint/parser": "^8.46.4",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "prettier": "^3.6.2",
        "rollup": "^4.53.3",
        "rollup-plugin-dts": "^6.2.3",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
